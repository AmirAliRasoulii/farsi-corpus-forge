# =====================================================================
# WHITE GENERATION PIPELINE ENVIRONMENT CONFIGURATION (.env.example)
# Never commit real API keys to version control!
# =====================================================================

# LLM Provider Configuration (AvalAI / OpenAI-compatible endpoint)
LLM_API_KEY=
LLM_BASE_URL=https://api.avalai.ir/v1
EXTRA_HEADERS={}

# Generator Model (Creates clean candidate variants from Persian seeds)
GENERATOR_MODEL=llama-3.3-70b-instruct
GENERATOR_API_ROUTE=chat
GENERATOR_OUTPUT_MODE=json_object
GENERATOR_MAX_TOKENS=4096
GENERATOR_TOKEN_FIELD=max_completion_tokens
GENERATOR_TEMPERATURE=0.7
GENERATOR_EXTRA_JSON={}

# Quality Model (Validates candidate Persian fluency and conversion success)
WHITE_QUALITY_MODEL=gpt-4o
WHITE_QUALITY_API_ROUTE=chat
WHITE_QUALITY_OUTPUT_MODE=json_object
WHITE_QUALITY_MAX_TOKENS=4096
WHITE_QUALITY_TOKEN_FIELD=max_completion_tokens
WHITE_QUALITY_TEMPERATURE=0.0
WHITE_QUALITY_EXTRA_JSON={}

# Four Independent Offense Judges (Blinded 4-Judge Panel)
# Must be distinct models configured on AvalAI
OFFENSE_JUDGE_1=gpt-4o-mini
OFFENSE_JUDGE_2=claude-haiku-4-5
OFFENSE_JUDGE_3=gemini-2.5-flash
OFFENSE_JUDGE_4=deepseek-chat

OFFENSE_JUDGE_ROUTE=chat
OFFENSE_JUDGE_OUTPUT_MODE=json_object
OFFENSE_JUDGE_MAX_TOKENS=2048
OFFENSE_JUDGE_TOKEN_FIELD=max_completion_tokens
OFFENSE_JUDGE_TEMPERATURE=0.0

# Concurrency, Timeouts, and Budgets
MAX_WORKERS=4
REQUEST_TIMEOUT=120
MAX_RETRIES=2
REQUESTS_PER_MINUTE=0
MAX_API_CALLS=0

# Recipe & Policy Paths
RECIPE_PROMPTS_FILE=white_generation/prompts/recipe_prompts.json
WHITE_QUALITY_PROMPT_FILE=white_generation/prompts/quality_prompt.md
OFFENSE_JUDGE_PROMPT_FILE=white_generation/prompts/offense_judge_prompt.md
GENERATION_POLICY_FILE=white_generation/config/generation_policy.json
DEFAULT_OUTPUT_DIR=outputs/white_generation
