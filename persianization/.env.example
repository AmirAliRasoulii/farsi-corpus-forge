# =====================================================================
# PERSIANIZATION PIPELINE ENVIRONMENT CONFIGURATION (.env.example)
# Never commit real API keys to version control!
# =====================================================================

# LLM Provider Configuration (AvalAI / OpenAI-compatible endpoint)
LLM_API_KEY=
LLM_BASE_URL=https://api.avalai.ir/v1
EXTRA_HEADERS={}

# Translation Models Configuration
# Primary translation model
TRANSLATOR_PRIMARY_MODEL=gpt-4o-mini
# Ordered fallback models if primary model refuses, errors, or fails quality/censorship check
TRANSLATOR_FALLBACK_MODELS=claude-haiku-4-5,gemini-2.5-flash

# Independent Quality Evaluation Models (MUST be distinct from primary AND all fallback models)
QUALITY_MODEL_1=deepseek-chat
# Second independent evaluator for blind 10% random sample and targeted high-risk cases
QUALITY_MODEL_2=command-r-plus

# Route, Output Mode, and Token Settings for Translation
TRANSLATOR_API_ROUTE=chat
TRANSLATOR_OUTPUT_MODE=json_object
TRANSLATOR_MAX_TOKENS=4096
TRANSLATOR_TOKEN_FIELD=max_completion_tokens
TRANSLATOR_TEMPERATURE=0.1
TRANSLATOR_EXTRA_JSON={}

# Route and Parameters for Quality Evaluator 1
QUALITY_1_API_ROUTE=chat
QUALITY_1_OUTPUT_MODE=json_object
QUALITY_1_MAX_TOKENS=4096
QUALITY_1_TOKEN_FIELD=max_completion_tokens
QUALITY_1_TEMPERATURE=0.0
QUALITY_1_EXTRA_JSON={}

# Route and Parameters for Quality Evaluator 2
QUALITY_2_API_ROUTE=chat
QUALITY_2_OUTPUT_MODE=json_object
QUALITY_2_MAX_TOKENS=4096
QUALITY_2_TOKEN_FIELD=max_completion_tokens
QUALITY_2_TEMPERATURE=0.0
QUALITY_2_EXTRA_JSON={}

# Batch Scheduling and Worker Concurrency
# Batch size for memory-bounded streaming
INPUT_BATCH_SIZE=50
# Maximum concurrent HTTP requests
MAX_CONCURRENT_REQUESTS=4
REQUEST_TIMEOUT=120
MAX_RETRIES=2
REQUESTS_PER_MINUTE=0
# 0 = unlimited calls; set >0 to enforce budget cap across all workers/judges
MAX_API_CALLS=0

# Quality Policy, Sampling, and Circuit Breaker
QUALITY_ACCEPT_THRESHOLD=4.0
HUMAN_AUDIT_SAMPLE_RATE=0.10
SECOND_JUDGE_SAMPLE_RATE=0.10
SECOND_JUDGE_TARGETED_ENABLED=true

# Circuit Breaker: Automatically pauses new scheduling if failure rate spikes
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_MAX_FAILURE_RATE=0.40
CIRCUIT_BREAKER_MIN_OBSERVATIONS=10

# Paths
PROMPT_TRANSLATOR_FILE=persianization/prompts/translator_prompt.md
PROMPT_QUALITY_FILE=persianization/prompts/quality_prompt.md
REVIEW_POLICY_FILE=persianization/config/review_policy.json
DEFAULT_OUTPUT_DIR=outputs/persianization
