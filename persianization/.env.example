# =====================================================================
# PERSIANIZATION PIPELINE ENVIRONMENT CONFIGURATION (.env.example)
# Never commit real API keys to version control!
# =====================================================================

# LLM Provider Configuration (AvalAI / OpenAI-compatible endpoint)
LLM_API_KEY=
LLM_BASE_URL=https://api.avalai.ir/v1
EXTRA_HEADERS={}

# Translation Models Configuration
# Primary translation model (AvalAI examples: gpt-4o-mini, claude-haiku-4-5, gemini-2.5-flash)
TRANSLATOR_PRIMARY_MODEL=gpt-4o-mini
# Ordered fallback models if primary model refuses, errors, or fails format
TRANSLATOR_FALLBACK_MODELS=claude-haiku-4-5,gemini-2.5-flash,deepseek-chat

# Independent Quality Evaluation Model (MUST be distinct from the translator model)
QUALITY_MODEL=deepseek-chat

# Route, Output Mode, and Token Settings for Translation
TRANSLATOR_API_ROUTE=chat
TRANSLATOR_OUTPUT_MODE=json_object
TRANSLATOR_MAX_TOKENS=4096
TRANSLATOR_TOKEN_FIELD=max_completion_tokens
TRANSLATOR_TEMPERATURE=0.1
TRANSLATOR_EXTRA_JSON={}

# Route and Parameters for Quality Evaluator
QUALITY_API_ROUTE=chat
QUALITY_OUTPUT_MODE=json_object
QUALITY_MAX_TOKENS=4096
QUALITY_TOKEN_FIELD=max_completion_tokens
QUALITY_TEMPERATURE=0.0
QUALITY_EXTRA_JSON={}

# Concurrency, Timeouts, and Budgets
MAX_WORKERS=4
REQUEST_TIMEOUT=120
MAX_RETRIES=2
REQUESTS_PER_MINUTE=0
# 0 = unlimited calls; set >0 to prevent runaway API spend
MAX_API_CALLS=0

# Quality Policy and Human Audit
QUALITY_ACCEPT_THRESHOLD=4.0
# Sampling fraction (0.0 to 1.0) of accepted translations diverted to HITL review queue
HUMAN_AUDIT_SAMPLE_RATE=0.10

# Paths
PROMPT_TRANSLATOR_FILE=persianization/prompts/translator_prompt.md
PROMPT_QUALITY_FILE=persianization/prompts/quality_prompt.md
REVIEW_POLICY_FILE=persianization/config/review_policy.json
DEFAULT_OUTPUT_DIR=outputs/persianization
